# GiftList devenv — local environment configuration.
#
# Copy this file to `.env` in this same directory before running `make up`:
#
#   cp .env.example .env
#
# `.env` is gitignored (see the root .gitignore's `.env` entry) — never commit it.
# `docker compose` reads `.env` automatically from the directory it runs in, which
# is why this file lives next to docker-compose.yml rather than at the repo root.
#
# None of these are actually required: every variable below is consumed by
# docker-compose.yml as `${VAR:-default}`, and the defaults here match the compose
# file's own fallbacks exactly. An empty .env — or no .env at all — is a fully
# valid configuration. Only change a value if its default port is already taken on
# your machine, or you want different RabbitMQ credentials locally.

# --- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- MongoDB ------------------------------------------------------------------
MONGO_PORT=27017

# --- Gateway (.NET, gRPC ingress + GraphQL) ------------------------------------
GATEWAY_PORT=8080

# --- Web (Vite dev server) ------------------------------------------------------
VITE_PORT=5173

# --- Identity (.NET, sign up / log in / JWT issuance) --------------------------
#
# JWT_SIGNING_KEY_PEM below is a COMMITTED, DEV-ONLY RSA private key (PKCS8 PEM). It exists
# purely so `make up` works out of the box on a clean clone (docs/ARCHITECTURE.md "Why workers still need a little HTTP"'s
# "public key mounted into the Gateway as config" needs *some* key pair to exist). It is
# world-readable in this repo's git history. NEVER reuse it anywhere real, never treat this
# pattern as how a production signing key should be provisioned (a secrets manager / vault,
# not a committed file, is the production answer), and feel free to regenerate it locally —
# nothing depends on it being this specific key:
#
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out /tmp/k.pem
#   python3 -c "print(open('/tmp/k.pem').read().strip().replace(chr(10), '\\\\n'))"
#   # ^ produces the single-line, '\n'-escaped form this value below is in.
#
# The '\n' sequences are literal backslash-n, not real newlines — JwtTokenIssuer un-escapes
# them before parsing, which is what lets a multi-line PEM travel as one KEY=VALUE env line.
# Identity fails fast at startup if Jwt__SigningKeyPem/Issuer/Audience end up empty
# (ARCHITECTURE.md "Why workers still need a little HTTP" — no silent default for a signing key), which is exactly why
# docker-compose.yml's own `${JWT_SIGNING_KEY_PEM:-...}` fallback bakes in this same value:
# an empty .env, or no .env at all, still has to work (this file's own opening paragraph).
JWT_SIGNING_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC18tWGbdPAf1Ol\nGjCybEAflbRDo8QZTsjY8ZCx0zG8mRTNF9B3IuVPa7fbmbB7Ixy8AaL2TZuUo5jF\n9XRI6URmn+0GuPTMG9IcpbKq7BcK1xfOF1C5fREwk2KeIyTHzA+Ec52uqcGNTOhb\nhfV3FLHc0Mku/i0OdIPvN/E8GIOBts5/NVv89I+9Gl5nwiAq2sugzdieviWhdRmd\nRyW6HzkZr5Q2nP+sFf2GCzpIt5w0il9gbaAk/vs5pib4f+7CYcNc8TwsCbKzMBC/\nU7PX63XJf6ustJcCh9Vdu/4lFCLM8bCH3w93luGrNOrCzr/YomMrW8+EZ2xJa6tL\no+4/S9YrAgMBAAECggEAL8S/VnnDHEjRdwk3O8C73Q76sr9uHo7WoE5bhLRD3JX8\nJhRYgM7CkWVgceEZulpvktSDKlMZw55n36EflHzZnm/iVN9+NZAgS7EdBU7SheAO\nuebZJLm3J5+qRoZHg8UJVebcwRyEWkqUvmKfHVJrl+OgzhuhTKg+czGmvfZZoFYi\n6kOSusXFydW4CEgQfcJFD+EXvRTgaqwNpbhazQ/wDIuB7FhptBd026KEGCPQ3PUX\nASFWcp0NKqGLObroG8qVADrSCnAVYwdr2MdVV3GK+uQ0fzCK+lhG5ir8lRDjwpix\n/Qkyr9DzefSdAeSshQMxcbhoP3uAjKGUTqfTb8tKEQKBgQDcu7VZAbFvGhpR92IJ\nFP/gR4LwzQyzQ2gS4/e/6aVKXuoFLDYC66vsDG+LH07KFPO6uifOpuwg2Vu1c2Na\nR86guOzRvXb7HKFholKvRthssGbzTeZwO3pu25xgxVCT8NYRPZOcg04cWHdP+aLT\n1qBz/AaHLEZu1CHm/0egSSnXHwKBgQDTBMefQqv0CWbNPCZ4EPazQShGJXrZmfHi\nEQiv6wnSNxLUtEAnU5NTwe1XdTtWSvH32NMrr9W8PKk4yLe8V8dJo98B0S+okvHZ\n7kSQiEhp1O9tLukjfbZXrsLC9NrJOJYIuTYeCtDUonVesuNl1oHLKk5wXoAnFhfo\n5V6QkDvbdQKBgGYDGjyYW7hNB/z5p4Uq/1ZXtlwzZ7sxW9ffI5C+GnXUh7L8S7nt\n0Pa2iJZzUaZzKHETt3H6EwbbbVbejPwcU5JT5J7KQUKsaKkGq8/1nfAdVnb7eZRE\n6MBzHkJa7nJwy34MRzv+MwtGl12OsYHVnzH7N8kg3Sw7Pa/UKvYY2g1hAoGBAM2Y\nsZo1Dm6FnnjGa0C+Xm8GQ+QcblaHDEnTiOBFo1sCt8EwIfVvE3Me1k1I9lg8SwbN\nZeoBtsBhZgriXUoPSCcyl3wgwUuAaE2KPZmIfu1GP0Tk2NfwivFhX3cts+Er1dqI\nAfdBWHhkFPEAYFh/qBQ3kxceq8PpXcBXgkxdi0RlAoGBANT1zOrNh2VgLNHWqD8f\nBlfZMX5EZxy3KtaIyGPXpMvwp4T9D/nYHIbnLmQWwgj8YpgTc3lwuGmiNaMJJBfA\nx0s2NUklkft/1KBochAdnMlyWxIpb4epQYSAbm0ytrxPxHgu6bQ+vuN9uhk8HEui\nD577JkCbY7upRZ8KGN7NWTVo\n-----END PRIVATE KEY-----
JWT_ISSUER=giftlist-identity
JWT_AUDIENCE=giftlist

# --- Gateway (.NET, gRPC ingress + GraphQL read model) --------------------------
#
# JWT_PUBLIC_KEY_PEM is the public half of JWT_SIGNING_KEY_PEM above (ARCHITECTURE.md "Why workers still need a little HTTP" —
# "public key mounted into the Gateway as config"): Identity signs an access token with the
# private key, the Gateway's myGiftLists/giftList(id) GraphQL queries validate it with this.
# Regenerate alongside JWT_SIGNING_KEY_PEM if you rotate that key locally:
#
#   openssl pkey -in /tmp/k.pem -pubout -out /tmp/k.pub.pem
#   python3 -c "print(open('/tmp/k.pub.pem').read().strip().replace(chr(10), '\\\\n'))"
#
# Gateway fails fast at startup if Jwt__PublicKeyPem/Issuer/Audience end up empty, same as
# Identity's own signing key (ARCHITECTURE.md "Why workers still need a little HTTP").
JWT_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAtfLVhm3TwH9TpRowsmxA\nH5W0Q6PEGU7I2PGQsdMxvJkUzRfQdyLlT2u325mweyMcvAGi9k2blKOYxfV0SOlE\nZp/tBrj0zBvSHKWyquwXCtcXzhdQuX0RMJNiniMkx8wPhHOdrqnBjUzoW4X1dxSx\n3NDJLv4tDnSD7zfxPBiDgbbOfzVb/PSPvRpeZ8IgKtrLoM3Ynr4loXUZnUcluh85\nGa+UNpz/rBX9hgs6SLecNIpfYG2gJP77OaYm+H/uwmHDXPE8LAmyszAQv1Oz1+t1\nyX+rrLSXAofVXbv+JRQizPGwh98Pd5bhqzTqws6/2KJjK1vPhGdsSWurS6PuP0vW\nKwIDAQAB\n-----END PUBLIC KEY-----

# NOTE: VITE_GATEWAY_URL is deliberately not listed here. docker-compose.yml sets
# it for the `web` service as a computed value derived from GATEWAY_PORT
# (`VITE_GATEWAY_URL: http://localhost:${GATEWAY_PORT:-8080}`), not by reading it
# out of the environment — so it isn't an independent setting. Change GATEWAY_PORT
# above and it follows automatically.
